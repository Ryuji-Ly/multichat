{
  "manifest_version": 3,
  "name": "Multichat",
  "version": "0.1.0",
  "description": "One livestream plus Twitch, YouTube and TikTok chats side by side, using your own logged-in accounts.",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["https://*.tiktok.com/*", "https://*.twitch.tv/*", "https://*.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Multichat" },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["tiktok-crop.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
